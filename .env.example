# Host-side ports. Every one is bound to 127.0.0.1. Container-side ports never change.
# If a port is taken on your Mac, copy this file to .env and change the number here.
PROXY_PORT=3000
INSIGHT_PORT=5540
REDIS_PORT=6379
PG_PORT=5432

# Load generation caps for traffic levels (LOW_POWER=1 halves both)
LOAD_MAX_CONNECTIONS=200
LOAD_MAX_DURATION_SEC=30
LOW_POWER=
