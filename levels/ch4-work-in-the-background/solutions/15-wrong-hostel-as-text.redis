# Wrong: the hostel id is a label, but it was indexed as TEXT. TEXT splits h-c-02-2 into words, so a tag query on it matches
# nothing and the "Shivneri contests up to 50 points" search returns an empty list.
FT.CREATE idx:contest ON JSON PREFIX 1 contest: SCHEMA $.name AS name TEXT $.hostel AS hostel TEXT $.entry AS entry NUMERIC SORTABLE $.tags[*] AS tags TAG
FT.SEARCH idx:contest '@hostel:{h\-c\-02\-2} @entry:[0 50]' RETURN 2 name entry
FT.AGGREGATE idx:contest "*" GROUPBY 1 @hostel REDUCE AVG 1 @entry AS avg_entry
