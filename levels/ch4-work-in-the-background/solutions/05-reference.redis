# Reference: a second group, created at $ so it sees only balls added from now on, then two new balls and one read without ack.
XGROUP CREATE match:m-041:balls analytics $
XADD match:m-041:balls * over 2 ball 1 batter p-028 runs 4
XADD match:m-041:balls * over 2 ball 2 batter p-034 runs 1
XREADGROUP GROUP analytics a1 COUNT 10 STREAMS match:m-041:balls >
XINFO GROUPS match:m-041:balls
