# Reference: one entry per ball, IDs generated by Redis. Over 1, six balls.
XADD match:m-041:balls * over 1 ball 1 runs 4
XADD match:m-041:balls * over 1 ball 2 runs 0
XADD match:m-041:balls * over 1 ball 3 runs 1
XADD match:m-041:balls * over 1 ball 4 runs 6
XADD match:m-041:balls * over 1 ball 5 runs 0
XADD match:m-041:balls * over 1 ball 6 runs 2
XLEN match:m-041:balls
XRANGE match:m-041:balls - +
