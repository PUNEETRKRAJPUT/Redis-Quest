{
	admin off
	auto_https off
}

:3000 {
	log {
		output file /logs/proxy/access.log
		format json
	}

	# /app/* keeps its prefix (handle, not handle_path): the app mounts its routes under /app.
	handle /app/* {
		# dynamic a: re-resolve the compose service name every second, so instances added or removed by
		# `--scale app=N` are picked up without a Caddy reload. round_robin then picks an upstream per request,
		# so a keep-alive browser connection no longer pins one instance.
		reverse_proxy {
			dynamic a {
				name app
				port 4000
				refresh 1s
				dial_timeout 1s
			}
			lb_policy round_robin
			lb_try_duration 2s
			lb_try_interval 250ms
		}
	}

	# The engine owns exactly these paths (engine/src/server.ts): /api/*, /health, /ws (WebSocket upgrade) and
	# /internal/* (app-config and metrics; the app reaches them over the network, scripts/grade through here).
	# One instance, so no balancing; flush_interval -1 keeps the WebSocket and long responses unbuffered.
	@engine path /api /api/* /health /health/* /ws /ws/* /internal/*
	handle @engine {
		reverse_proxy engine:4200 {
			flush_interval -1
		}
	}

	# The start page reads this file to show how far `scripts/start` has got. scripts/start writes it under the logs
	# folder (logs/start/stage.json), which this proxy already mounts at /logs. Never cached: it changes every few seconds.
	handle /_starting/stage.json {
		root * /logs/start
		rewrite * /stage.json
		header Cache-Control "no-store"
		file_server
	}

	# Everything else is a page, a `/_next/` asset or a Next.js data request: the ui service (container port 3100).
	# While ui is still starting, or stopped, Caddy answers 502 (handle_errors below keeps that code and sends a page).
	handle {
		reverse_proxy ui:3100 {
			flush_interval -1
		}
	}

	# When the ui service does not answer, a page request gets the self-contained start page from docker/starting/
	# (mounted at /srv/starting) instead of an empty 502. The status code is the error's own, so everything that checks
	# for 502 still sees 502. Only page requests: the engine's paths, /app/* and /_next/* assets stay bare errors.
	handle_errors {
		@startpage not path /api /api/* /health /health/* /ws /ws/* /internal/* /app/* /_next/* /_starting/*
		handle @startpage {
			root * /srv/starting
			rewrite * /index.html
			header Cache-Control "no-store"
			file_server {
				status {err.status_code}
			}
		}
	}
}
