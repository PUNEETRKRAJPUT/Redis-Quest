{
	admin off
	auto_https off
}

:3000 {
	log {
		output file /logs/proxy/access.log
		format json
	}

	# /app/* keeps its prefix (handle, not handle_path): the app mounts its routes under /app.
	handle /app/* {
		# dynamic a: re-resolve the compose service name every second, so instances added or removed by
		# `--scale app=N` are picked up without a Caddy reload. round_robin then picks an upstream per request,
		# so a keep-alive browser connection no longer pins one instance.
		reverse_proxy {
			dynamic a {
				name app
				port 4000
				refresh 1s
				dial_timeout 1s
			}
			lb_policy round_robin
			lb_try_duration 2s
			lb_try_interval 250ms
		}
	}

	# Everything else, WebSocket upgrades included, goes to the single engine instance.
	handle {
		reverse_proxy engine:4200 {
			flush_interval -1
		}
	}
}
